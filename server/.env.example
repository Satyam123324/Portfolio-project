# Copy this file to ".env" and fill in your values.

# Port the server listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Frontend origin(s) allowed to call the API (comma-separated).
# Add your deployed site here, e.g. https://satyam123324.github.io
CLIENT_ORIGIN=http://localhost:3000
